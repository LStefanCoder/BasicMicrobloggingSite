<!DOCTYPE html>
<html>
    <head>
        <title>Author homepage</title>
        <link rel="stylesheet" href="/css/bootstrap.css">
        <link rel="stylesheet" href="/css/custom.css">
    </head>
    <body>
        <!--used tip from https://stackoverflow.com/questions/19827605/change-bootstrap-navbar-collapse-breakpoint-without-using-less-->
        <!--The "navbar-expand' makes sure that the menu never collapses"-->
        <!--code based on the first example in https://getbootstrap.com/docs/4.0/components/navbar/-->
        <nav class="navbar navbar-expand navbar-dark bg-primary">
            <a class="navbar-brand" href="#">Microblogging site</a>
              <div class="collapse navbar-collapse">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item active">
                      <a class="nav-link" href="#">Author page<span class="sr-only">(current)</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/reader/home">Reader page</a>
                      </li>
                      <li class="nav-item">
                        <a class="nav-link" href="/author/settings">Author settings</a>
                      </li>
                </ul>
              </div>
        </nav>
        <!--An empty div to put a bit of space between the elements-->
        <div style="height: 20px;"></div>
        <!--These are the values inserted from the user record database-->
        <h5><b>Microblogger: </b>Author page</h5>
        <h1 class="text-center"><%= author[0].blogdata_title %></h2>
        <h2 class="text-center"><%= author[0].blogdata_subtitle %></h2>
        <h3 class="text-center"><%= author[0].blogdata_authorname %></h3>

        <!--The table with the draft articles-->
        <h2>Draft Articles</h2>
        <table class="table table-striped table-hover">
            <thead class="thead bg-primary text-white">
                <tr>
                    <th>Title</th>
                    <th>Subtitle</th>
                    <th>Created</th>
                    <th>Last modified</th>
                    <!--Empty table headings for the buttons-->
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <!--this uses ejs templating to dynamically populate a table with the draft articles-->
            <tbody>
                <% for (var i = 0; i < draft.length; i++) { %>
                <tr>
                    <td>
                        <%= draft[i].title %>
                    </td>
                    <td>
                        <%= draft[i].subtitle %>
                    </td>
                    <td>
                        <%= draft[i].createddate %>
                    </td>
                    <td>
                        <%= draft[i].updateddate %>
                    </td>
                    <td>
                        <!--the onclick attribute changes the link adress to one with the appropriate article id-->
                        <!--based on https://www.geeksforgeeks.org/how-to-insert-a-javascript-variable-inside-href-attribute/-->
                        <a href="editarticle/" onclick="var value = '<%= draft[i].article_id %>'; location.href = this.href + value; return false;" style="text-decoration: none;"><button class="btn btn-secondary">EDIT</button></a>
                    </td>
                    <!--the window.location.reload() is needed to refresh the page to display the articles correctly-->
                    <!--there's also a setTimeout which is needed for the correct refreshing of the page-->
                    <td>
                        <button type="submit" name="publishdraft" onclick="var value = '<%= draft[i].article_id %>'; fetch('/author/publishdraft/' + value, {method: 'GET'}); setTimeout(function() {window.location.reload()},1000)" class="btn btn-secondary">PUBLISH</button>
                    </td>
                    <td>
                        <button type="submit" name="deletedraft" onclick="var value = '<%= draft[i].article_id %>'; fetch('/author/deletedraft/' + value, {method: 'GET'}); window.location.reload()" class="btn btn-secondary">DELETE</button>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>

        <div class="spacer">
            <a href="/author/draft" style="text-decoration: none;"><button class="btn btn-outline-primary mx-auto">Create new draft</button></a>
        </div>

        <!--The table with the published articles-->
        <h2>Published Articles</h2>
        <!--table-striped creates a table with -->
        <table class="table table-striped table-hover">
            <thead class="thead bg-primary text-white">
                <tr>
                    <th>Title</th>
                    <th>Subtitle</th>
                    <th>Published</th>
                    <th>Last modified</th>
                    <th>Likes</th>
                    <!--Empty table headings for the buttons-->
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <!--this uses ejs templating to dynamically populate a table with the published articles-->
            <tbody>
                <% for (var i = 0; i < published.length; i++) { %>
                <tr>
                    <td>
                        <%= published[i].title %>
                    </td>
                    <td>
                        <%= published[i].subtitle %>
                    </td>
                    <td>
                        <%= published[i].publisheddate %>
                    </td>
                    <td>
                        <%= published[i].updateddate %>
                    </td>
                    <td>
                        <%= published[i].numberoflikes %>
                    </td>
                    <!--the "share" button gives a pop-up window with the link to the reader version of the article-->
                    <td>
                        <button type="submit" onclick="var link = 'http:/' + '/localhost:3000/reader/article/' + '<%= published[i].article_id %>'; confirm(link);" class="btn btn-secondary">SHARE</button>
                    </td>
                    <td>
                        <button type="submit" name="deletepublished" onclick="var value = '<%= published[i].article_id %>'; fetch('/author/deletepublished/' + value, {method: 'GET'}); window.location.reload()" class="btn btn-secondary">DELETE</button>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>

       
    </body>
</html>
